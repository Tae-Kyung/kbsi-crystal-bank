  "paper": {
    "title": "KBSI-CrystalBank: A Comprehensive AI-Ready Database of 1.16 Million Protein Crystallization Conditions Including Failure Data",
    "keywords": ["protein crystallization", "structural biology", "machine learning", "database", "failure data", "negative controls", "ESM-2", "MCP", "data quality"],
    "sections": ["Abstract", "Background & Summary", "Methods", "Data Records", "Technical Validation", "Usage Notes", "Code Availability"],
    "figure_count": 8,
    "table_count": 8,
    "reference_count": 16
  },

  "contributions": [
    {
      "id": 1,
      "claim": "Scale and completeness",
      "evidence": "1,161,043 crystallization conditions for 59,349 proteins through 286,581 constructs, pH coverage 99.5%, temperature 94.2%"
    },
    {
      "id": 2,
      "claim": "Failure data inclusion",
      "evidence": "927,388 synthetic negative controls via 14 biophysically motivated strategies, transparently tagged with source_type='synthetic'"
    },
    {
      "id": 3,
      "claim": "Full pipeline integration",
      "evidence": "Expression 29,153 + Purification 13,356 + Characterization 7,195 records from LLM extraction (81.4% accuracy)"
    },
    {
      "id": 4,
      "claim": "Sequence-level representations",
      "evidence": "ESM-2 embeddings (esm2_t33_650M_UR50D, 1280-dim) for 284,184 proteins (99.2%), pgvector IVFFlat index"
    },
    {
      "id": 5,
      "claim": "AI accessibility",
      "evidence": "MCP server with 18 tools across 4 categories: Search(9), Similarity(2), Prediction(4), Analytics(3)"
    }
  ],

