  "usage_notes": {
    "recommended_uses": [
      "Crystallization condition screening via ESM-2 similarity",
      "ML model training with balanced success/failure data",
      "Expression system optimization (host × tag × temperature)",
      "Drug target crystallizability assessment"
    ],
    "limitations": [
      "Synthetic negatives are computationally generated, not experimentally observed — use source_type filter",
      "LLM extraction 81.4% accuracy — ~1 in 5 expression/purification records may have errors",
      "Precipitant type coverage 56.6% — moderate, filter for non-null precipitant_type for precipitant-specific analyses",
      "Temporal bias toward well-studied organisms and druggable families",
      "Crystallization is stochastic — database captures reported conditions, not full variability"
    ]
  },

