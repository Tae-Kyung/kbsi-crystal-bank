  "methods": {
    "data_sources": [
      { "name": "RCSB PDB", "what": "Crystallization conditions, structures, sequences", "parsing": "Rule-based regex, validated 98.5% on 200 samples" },
      { "name": "TargetTrack", "what": "Expression/purification metadata from PSI", "matching": "Target IDs + sequence alignment" },
      { "name": "ChEMBL + BindingDB", "what": "Ligand binding data (IC50, Kd, Ki)", "linking": "UniProt ID mapping" },
      { "name": "Europe PMC + CrossRef", "what": "Publication metadata, DOIs", "coverage": "98.7% of structures" },
      { "name": "UniProt + SIFTS", "what": "Functional annotations, gene names, cross-references", "coverage": "62.6% gene names" }
    ],

    "collection_pipeline": {
      "total_scripts": 41,
      "orchestration": "DAG-based pipeline runner (ops-harness.ts)",
      "layers": [
        { "layer": 0, "name": "Primary harvest", "scripts": 3, "description": "Bulk PDB, TargetTrack, ChEMBL" },
        { "layer": 1, "name": "Structure-level extraction", "scripts": 5, "description": "Diffraction, ligands, NMR, papers" },
        { "layer": 2, "name": "Metadata backfill", "scripts": 6, "description": "Expression, UniProt, protein/structure metadata, mutations" },
        { "layer": 3, "name": "Enrichment", "scripts": 8, "description": "Conditions, gene names, BMRB, MW, seq hashes" },
        { "layer": 4, "name": "Quality assurance", "scripts": 5, "description": "Normalization, cleanup, dedup, search index" },
        { "layer": 5, "name": "Validation", "scripts": 1, "description": "Cross-database concordance" }
      ]
    },

    "llm_extraction": {
      "model": "GPT-4o-mini (OpenAI)",
      "pipeline": ["Extraction from full-text", "Staging table with confidence", "Human review (approve/reject/correct)"],
      "accuracy": 81.4,
      "expression_host_accuracy": 89.8,
      "error_modes": { "ambiguous_multi_protein": 7.2, "non_standard_nomenclature": 4.8 },
      "validation_set_size": 500
    },

    "negative_controls": {
      "total": 927388,
      "strategies_count": 14,
      "categories": {
        "extreme_perturbation": {
          "count": 4,
          "strategies": ["extreme_pH (<2 or >12)", "extreme_temperature (<-10 or >55C)", "extreme_concentration (3x max)", "zero_precipitant"]
        },
        "realistic_variation": {
          "count": 6,
          "strategies": ["pH_shift_pm2", "temperature_shift_pm15C", "precipitant_type_swap", "concentration_half_double", "buffer_mismatch", "method_swap"]
        },
        "systematic_controls": {
          "count": 4,
          "strategies": ["random_combinatorial", "cross_protein_transfer", "targettrack_failures", "anti_optimized"]
        }
      },
      "tagging": "source_type='synthetic', source_db='synthetic', notes=generation_strategy"
    },

    "esm2_embeddings": {
      "model": "esm2_t33_650M_UR50D",
      "dimensions": 1280,
      "gpu": "NVIDIA RTX A6000",
      "extraction": "Mean-pooled final transformer layer",
      "storage": "PostgreSQL + pgvector IVFFlat (100 lists)",
      "query_speed": "Sub-second nearest-neighbor across 284,184 proteins"
    },

    "database_schema": {
      "model": "Construct-centric relational",
      "tables": 21,
      "key_decisions": [
        "NULL = not attempted; explicit value = attempted (including failure)",
        "Outcome ordinal enum: clear < precipitate < phase_separation < microcrystal < single_crystal < diffraction_quality",
        "Every record: source_type + source_db + source_id for provenance",
        "Ordinal enums for ML-friendly integer encoding"
      ],
      "table_groups": {
        "core": ["protein", "construct", "mutation", "database_id"],
        "experiments": ["expression", "purification", "characterization", "crystallization", "diffraction", "nmr_experiment", "cryoem_session", "structure"],
        "ligands": ["ligand", "construct_ligand"],
        "support": ["reference", "extraction_staging", "audit_log", "embedding"]
      }
    },

    "prediction_benchmark": {
      "task": "Binary crystallization success prediction",
      "success_classes": ["single_crystal", "diffraction_quality"],
      "features": ["pH", "temperature", "precipitant_type (one-hot)", "precipitant_concentration", "MW", "pI", "sequence_length", "organism", "ESM-2 embedding (1280-dim)"],
      "models": ["k-NN (k=3,5,10,15)", "XGBoost", "LightGBM"],
      "cv": "80/20 stratified split",
      "best_result": {
        "model": "LightGBM + ESM-2",
        "accuracy": 0.942,
        "precision": 0.909,
        "recall": 0.940,
        "f1": 0.924,
        "auc_roc": 0.984
      },
      "baseline_result": {
        "model": "XGBoost (no ESM-2)",
        "accuracy": 0.933,
        "precision": 0.904,
        "f1": 0.916
      },
      "feature_importance": { "precipitant_cat": 0.258, "pH": 0.250, "temperature": 0.153 },
      "ablation": { "with_esm2": 0.942, "without_esm2": 0.933, "delta": 0.009 }
    }
  },

